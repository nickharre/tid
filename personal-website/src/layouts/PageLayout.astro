---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <!-- Return to depth button -->
  <a
    href="/"
    class="fixed top-6 left-6 z-50 flex items-center gap-2 px-3 py-2 rounded-full
           border border-text-dim/20 text-text-dim text-xs font-mono
           hover:border-biolum/30 hover:text-biolum hover:shadow-[0_0_15px_var(--glow-green)]
           transition-all duration-500"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
    Return to depth
  </a>

  <!-- Ambient atmosphere — subtle drifting particles -->
  <div class="fixed inset-0 pointer-events-none z-[1] overflow-hidden" aria-hidden="true">
    <div class="page-particle" style="left: 8%; top: 15%; --dur: 22s; --dx: 20px; --dy: -35px;" />
    <div class="page-particle" style="left: 20%; top: 55%; --dur: 26s; --dx: -15px; --dy: -25px;" />
    <div class="page-particle" style="left: 45%; top: 30%; --dur: 20s; --dx: 25px; --dy: -40px;" />
    <div class="page-particle" style="left: 60%; top: 70%; --dur: 24s; --dx: -20px; --dy: -30px;" />
    <div class="page-particle" style="left: 80%; top: 40%; --dur: 28s; --dx: 15px; --dy: -45px;" />
    <div class="page-particle lg" style="left: 35%; top: 80%; --dur: 30s; --dx: -10px; --dy: -20px;" />
    <div class="page-particle lg" style="left: 72%; top: 20%; --dur: 32s; --dx: 12px; --dy: -25px;" />
  </div>

  <main id="main-content" class="relative z-10 pt-20 pb-24 px-4">
    <slot />
  </main>

  <!-- Minimal footer -->
  <footer class="relative z-10 border-t border-text-dim/10 py-8 px-4 text-center">
    <p class="text-text-dim/40 text-xs font-mono">
      &copy; {new Date().getFullYear()} Nicholas Harre
    </p>
  </footer>
</BaseLayout>

<style>
  .page-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--biolum);
    opacity: 0.35;
    box-shadow: 0 0 6px var(--biolum), 0 0 12px var(--glow-green);
    animation: page-drift var(--dur, 20s) ease-in-out infinite;
  }

  .page-particle.lg {
    width: 4px;
    height: 4px;
    opacity: 0.2;
    background: var(--biolum-cyan);
    box-shadow: 0 0 8px var(--biolum-cyan), 0 0 16px var(--glow-cyan);
  }

  @keyframes page-drift {
    0%, 100% {
      transform: translate(0, 0);
      opacity: 0.35;
    }
    50% {
      transform: translate(var(--dx, 20px), var(--dy, -30px));
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-particle {
      animation: none;
    }
  }
</style>
